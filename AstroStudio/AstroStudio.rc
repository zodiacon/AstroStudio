IDR_MAINFRAME MENU
BEGIN
    POPUP "&File"
    BEGIN
        POPUP "&New"
        BEGIN
            MENUITEM "&Chart...",                   ID_NEW_CHART
            MENUITEM "Chart for Now",               ID_NEW_CHARTFORNOW
        END
        MENUITEM "&Open Chart...\tCtrl+O",      ID_FILE_OPEN
        MENUITEM "&Save\tCtrl+S",               ID_FILE_SAVE
        MENUITEM "Save Chart &As...",           ID_FILE_SAVE_AS
        MENUITEM "&Export...",                  ID_FILE_EXPORT
        MENUITEM SEPARATOR
        MENUITEM "&Print...\tCtrl+P",           ID_FILE_PRINT
        MENUITEM "Print Pre&view",              ID_FILE_PRINT_PREVIEW
        MENUITEM "P&rint Setup...",             ID_FILE_PRINT_SETUP
        MENUITEM SEPARATOR
        POPUP "&Recent Files"
        BEGIN
            MENUITEM "(empty)",                     ID_FILE_MRU_FIRST
        END
        MENUITEM SEPARATOR
        MENUITEM "E&xit",                       ID_APP_EXIT
    END
    POPUP "&Edit"
    BEGIN
        MENUITEM "&Undo\tCtrl+Z",               ID_EDIT_UNDO
        MENUITEM SEPARATOR
        MENUITEM "Cu&t\tCtrl+X",                ID_EDIT_CUT
        MENUITEM "&Copy\tCtrl+C",               ID_EDIT_COPY
        MENUITEM "&Paste\tCtrl+V",              ID_EDIT_PASTE
    END
    POPUP "&View"
    BEGIN
        MENUITEM "&Status Bar",                 ID_VIEW_STATUS_BAR
    END
    POPUP "&Chart"
    BEGIN
        MENUITEM "Step &Back\tAlt+Left",        ID_CHART_STEP_BACK
        MENUITEM "Step &Forward\tAlt+Right",    ID_CHART_STEP_FORWARD
        MENUITEM SEPARATOR
        MENUITEM "&Auto Step",                  ID_CHART_AUTOSTEP
        MENUITEM "&Live",                       ID_CHART_LIVE
        MENUITEM SEPARATOR
        POPUP "&Overlay"
        BEGIN
            MENUITEM "&None",                       ID_CHART_OVERLAY_NONE
            MENUITEM "&Transits",                   ID_CHART_TRANSITS
            MENUITEM "&Secondary Progressions",     ID_CHART_OVERLAY_PROGRESSED
            MENUITEM "Solar &Arc Directions",       ID_CHART_OVERLAY_SOLARARC
            MENUITEM "S&ynastry...",                ID_CHART_OVERLAY_SYNASTRY
        END
    END
    POPUP "&Tools"
    BEGIN
        MENUITEM "&Ephemeris",                  ID_TOOL_EPHEMERIS
    END
    POPUP "&Options"
    BEGIN
        MENUITEM "&Aspects...",                 ID_OPTIONS_ASPECTS
        MENUITEM SEPARATOR
        MENUITEM "&Always On Top",              ID_OPTIONS_ALWAYSONTOP
        MENUITEM "&Font...",                    ID_OPTIONS_FONT
        MENUITEM "&Dark Mode",                  ID_OPTIONS_DARKMODE
    END
    POPUP "&Window"
    BEGIN
        MENUITEM "&Close\tCtrl+F4",             ID_WINDOW_CLOSE
        MENUITEM "Close &All",                  ID_WINDOW_CLOSE_ALL
    END
    POPUP "&Help"
    BEGIN
        MENUITEM "&About AstroStudio...",       ID_APP_ABOUT
    END
END

IDR_CONTEXT MENU
BEGIN
    POPUP "ephemeris"
    BEGIN
        MENUITEM "&Copy\tCtrl+C",               ID_EDIT_COPY
        MENUITEM SEPARATOR
        MENUITEM "&Chart",                      ID_NEW_CHART
    END
END


